# Maintainer: fanchao <dev at fanchao dot dev>
#
# Repackages the release's .deb for Arch Linux. The build workflow fills in
# the @...@ fields (packaging/linux/pkgbuild.sh) and attaches the result to
# the release as farsight-server-bin.PKGBUILD; save it as PKGBUILD and run
# makepkg -si.

pkgname=farsight-server-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Low-latency remote desktop server for headless Linux machines'
arch=(x86_64 aarch64)
url='https://github.com/simophin/farsight'
license=('MIT OR Apache-2.0')
# The .deb's Depends under Arch's names: glibc, gcc-libs, libpipewire and
# libgbm (mesa) from the ELF file, EGL, which it loads at runtime, and the
# session's bus and audio daemons and keymaps.
depends=(
  glibc gcc-libs libpipewire mesa libglvnd
  dbus pipewire wireplumber pipewire-pulse xkeyboard-config
)
optdepends=(
  'labwc: the default desktop'
  'sway: another desktop'
  'libva: VA-API encoding'
  'libva-driver: VA-API encoding'
  'nvidia-utils: NVENC encoding'
)
provides=(farsight-server)
conflicts=(farsight-server)
# Ship the binary exactly as it is in the .deb.
options=(!strip !debug)
_release=$url/releases/download/@TAG@
source_x86_64=("$_release/farsight-server_@DEBVER@_amd64.deb")
source_aarch64=("$_release/farsight-server_@DEBVER@_arm64.deb")
sha256sums_x86_64=('@SHA256_AMD64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  install -Dm644 "$pkgdir/usr/share/doc/farsight-server/copyright" \
    "$pkgdir/usr/share/licenses/$pkgname/copyright"
}
