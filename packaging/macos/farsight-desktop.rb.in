# farsight's desktop client as a Homebrew formula, for the
# cloudwalkerlabs/homebrew-tap tap:
#
#   brew install cloudwalkerlabs/tap/farsight-desktop
#
# The build workflow fills in the @...@ fields (packaging/macos/formula.sh),
# attaches the result to the release and pushes it to the tap as
# Formula/farsight-desktop.rb.
class FarsightDesktop < Formula
  desc "Low-latency remote desktop client for farsight servers"
  homepage "https://github.com/cloudwalkerlabs/farsight"
  url "@URL@"
  version "@VERSION@"
  sha256 "@SHA256@"
  license any_of: ["MIT", "Apache-2.0"]

  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "farsight-desktop"
    # README.md, and FFmpeg's and dav1d's notices.
    doc.install Dir["*"]
  end

  test do
    system bin/"farsight-desktop", "--help"
  end
end
